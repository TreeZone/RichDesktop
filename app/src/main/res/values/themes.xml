<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PipDesk" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- 全局关闭触感震动反馈：整个 app（长按/拖动/列表等）都不震 -->
        <item name="android:hapticFeedbackEnabled">false</item>
        <!-- 透出壁纸，做成桌面的样子 -->
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <!-- 所有 AlertDialog 统一走深色玻璃主题：白字 + 透明窗底（否则深底配深灰字看不清） -->
        <item name="alertDialogTheme">@style/Theme.PipDesk.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.PipDesk.Dialog</item>
    </style>

    <!--
      玻璃对话框：
        · 窗口透明，底色由 Ui.glassWindow() 画（半透明 + 圆角 + Android 12+ 背景模糊）；
        · 继承 AppCompat 的深色 Alert 主题 → 标题/正文/列表项都是白字，深浅对比够。
      兼容性：windowIsTranslucent 是 API 1 就有的能力，安卓 9~16 全部适用。
    -->
    <style name="Theme.PipDesk.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <!-- 关键：把 AlertDialog 自带的内层面板底（abc_dialog_material_background，一层
             灰色圆角矩形）干掉，否则它叠在 Ui.glassWindow 的玻璃底上 = 「两层玻璃」 -->
        <item name="alertDialogStyle">@style/PipDesk.AlertPanel</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:backgroundDimAmount">0.22</item>
        <!-- 窗口不要投影：深色壁纸上那圈阴影会被看成"弹框外面又套了一层" -->
        <item name="android:windowElevation">0dp</item>
        <item name="colorAccent">#FF7FD0FF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
    </style>

    <!-- AlertDialog 内层面板：只保留布局结构，背景全透明（玻璃底由窗口统一负责） -->
    <style name="PipDesk.AlertPanel" parent="AlertDialog.AppCompat">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorBackgroundFloating">@android:color/transparent</item>
    </style>

    <!-- 浅色外观的对话框：浅色玻璃底（Ui.glassPanel 浅色分支）+ 黑字 -->
    <style name="Theme.PipDesk.Dialog.Light" parent="Theme.AppCompat.Dialog.Alert">
        <item name="alertDialogStyle">@style/PipDesk.AlertPanel</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:backgroundDimAmount">0.18</item>
        <item name="android:windowElevation">0dp</item>
        <item name="colorAccent">#FF3D7DD8</item>
        <item name="android:textColorPrimary">#E6000000</item>
        <item name="android:textColorSecondary">#99000000</item>
    </style>

    <!-- 桌面设置：半透明窗 + 壁纸底，配 Ui.blurWindow() 就是毛玻璃整页 -->
    <style name="Theme.PipDesk.Settings" parent="Theme.PipDesk">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>

    <style name="Theme.PipDesk.Blank" parent="Theme.PipDesk">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@color/blank_bg</item>
    </style>

</resources>
